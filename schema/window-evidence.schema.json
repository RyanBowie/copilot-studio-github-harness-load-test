{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed supplemental native window and failure evidence",
  "description": "Optional offline-derived supplement. Exact decimal strings are authoritative boundaries, not increased clock accuracy. No raw evidence, identifiers or source fingerprints.",
  "anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}],
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "offset": {"type": "number", "minimum": 0, "maximum": 86400000},
    "exact": {"type": "string", "maxLength": 73, "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,60})?$"},
    "key": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["startOffsetMs", "endOffsetMs", "startOffsetMsExact", "endOffsetMsExact", "durationMs", "durationMsExact"],
      "properties": {
        "startOffsetMs": {"$ref": "#/$defs/offset"}, "endOffsetMs": {"$ref": "#/$defs/offset"},
        "startOffsetMsExact": {"$ref": "#/$defs/exact"}, "endOffsetMsExact": {"$ref": "#/$defs/exact"},
        "durationMs": {"$ref": "#/$defs/offset"}, "durationMsExact": {"$ref": "#/$defs/exact"}
      }
    },
    "bounds": {
      "description": "Inclusive event-clock bounds. A nonzero bounded interval represents uncertainty, not invocation duration.",
      "type": "object", "additionalProperties": false,
      "required": ["precision", "lowerMs", "upperMs", "lowerMsExact", "upperMsExact"],
      "properties": {
        "precision": {"enum": ["exact", "bounded"]},
        "lowerMs": {"$ref": "#/$defs/offset"}, "upperMs": {"$ref": "#/$defs/offset"},
        "lowerMsExact": {"$ref": "#/$defs/exact"}, "upperMsExact": {"$ref": "#/$defs/exact"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatched", "settled", "successes", "failures", "outstandingClientCalls"],
      "properties": {
        "dispatched": {"$ref": "#/$defs/count"}, "settled": {"$ref": "#/$defs/count"},
        "successes": {"$ref": "#/$defs/count"}, "failures": {"$ref": "#/$defs/count"},
        "outstandingClientCalls": {"$ref": "#/$defs/count"}
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatched", "eventualSuccesses", "eventualFailures", "pendingAtEvidenceCutoff"],
      "properties": {
        "dispatched": {"$ref": "#/$defs/count"}, "eventualSuccesses": {"$ref": "#/$defs/count"},
        "eventualFailures": {"$ref": "#/$defs/count"}, "pendingAtEvidenceCutoff": {"$ref": "#/$defs/count"}
      }
    },
    "dispatch": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatched", "eventualSuccesses", "eventualFailures", "pendingAtEvidenceCutoff", "successesBeforeWindowEnd", "failuresBeforeWindowEnd", "pendingImmediatelyBeforeWindowEnd"],
      "properties": {
        "dispatched": {"$ref": "#/$defs/count"}, "eventualSuccesses": {"$ref": "#/$defs/count"},
        "eventualFailures": {"$ref": "#/$defs/count"}, "pendingAtEvidenceCutoff": {"$ref": "#/$defs/count"},
        "successesBeforeWindowEnd": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
        "failuresBeforeWindowEnd": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
        "pendingImmediatelyBeforeWindowEnd": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]}
      }
    },
    "completions": {
      "type": "object", "additionalProperties": false, "required": ["successes", "failures", "settled"],
      "properties": {"successes": {"$ref": "#/$defs/count"}, "failures": {"$ref": "#/$defs/count"}, "settled": {"$ref": "#/$defs/count"}}
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "dispatchCohort", "completionsInWindow", "clientStateBeforeWindowStart", "clientStateBeforeWindowEnd"],
      "properties": {
        "window": {"$ref": "#/$defs/range"}, "dispatchCohort": {"$ref": "#/$defs/dispatch"},
        "completionsInWindow": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/completions"}]},
        "clientStateBeforeWindowStart": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/state"}]},
        "clientStateBeforeWindowEnd": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/state"}]}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["durationSeconds", "dispatchCohortMaximum", "completionMaximum"],
      "properties": {
        "durationSeconds": {"enum": [10, 30, 60, 120, 300, 900, 3600]},
        "dispatchCohortMaximum": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]},
        "completionMaximum": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]}
      }
    },
    "basis": {
      "type": "object", "additionalProperties": false, "required": ["basis", "coverage", "windows"],
      "properties": {
        "basis": {"enum": ["observed_arrival_only", "observed_through_drain"]},
        "coverage": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/range"}]},
        "windows": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/window"}}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence", "completion", "client", "harnessAttribution"],
      "properties": {
        "evidence": {"enum": ["unclassified_invocation_failure", "workiq_mcp_transport_429"]},
        "completion": {"$ref": "#/$defs/bounds"}, "client": {"$ref": "#/$defs/state"},
        "harnessAttribution": {"const": "unknown"}
      }
    },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "completion", "dispatchClose", "client", "consecutiveGenericFailures", "newDispatchesAfterTrigger", "settlementsAfterTrigger", "harnessAttribution"],
      "properties": {
        "reason": {"enum": ["generic_error_threshold", "workiq_mcp_transport_429"]},
        "completion": {"$ref": "#/$defs/bounds"}, "dispatchClose": {"$ref": "#/$defs/bounds"},
        "client": {"$ref": "#/$defs/state"}, "consecutiveGenericFailures": {"$ref": "#/$defs/count"},
        "newDispatchesAfterTrigger": {"const": 0}, "harnessAttribution": {"const": "unknown"},
        "settlementsAfterTrigger": {
          "type": "object", "additionalProperties": false, "required": ["successes", "failures", "pendingAtFinalCutoff"],
          "properties": {"successes": {"$ref": "#/$defs/count"}, "failures": {"$ref": "#/$defs/count"}, "pendingAtFinalCutoff": {"$ref": "#/$defs/count"}}
        }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["runKey", "campaignKey", "nativeCompletionOffsetsExact", "counts", "firstError", "safetyTrigger", "bases"],
      "properties": {
        "runKey": {"$ref": "#/$defs/key"}, "campaignKey": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/key"}]},
        "nativeCompletionOffsetsExact": {"type": "boolean"}, "counts": {"$ref": "#/$defs/totals"},
        "firstError": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
        "safetyTrigger": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/trigger"}]},
        "bases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/basis"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "reviewedOn", "newAgentCalls", "existingNativeAttemptsAnalyzed", "windowInterval", "selection", "runs"],
      "properties": {
        "schemaVersion": {"const": 1}, "reviewedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "newAgentCalls": {"const": 0}, "existingNativeAttemptsAnalyzed": {"$ref": "#/$defs/count"},
        "windowInterval": {"const": "half_open_start_inclusive_end_exclusive"},
        "selection": {"const": "independent_post_hoc_success_maxima"},
        "runs": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/run"}}
      }
    }
  }
}
